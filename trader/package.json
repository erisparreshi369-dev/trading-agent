{
  "name": "trader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "collector": "node dist/collector/index.js",
    "dev:collector": "tsx src/collector/index.ts",
    "verify:live": "tsx src/tools/verify-live.ts",
    "trader": "node dist/trader/index.js",
    "score": "node dist/scoring/index.js",
    "kill": "tsx src/tools/kill.ts kill",
    "unkill": "tsx src/tools/kill.ts unkill",
    "telegram:setup": "tsx src/tools/telegram-setup.ts",
    "notifier": "node dist/notifier/index.js",
    "intel": "node dist/intel/index.js"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "better-sqlite3": "^12.11.1",
    "bs58": "^6.0.0",
    "dotenv": "^16.6.1",
    "pino": "^9.14.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
