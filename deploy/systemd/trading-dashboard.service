[Unit]
Description=trading-agent read-only dashboard (http://localhost:8080)
After=trading-collector.service
# give up (and fire OnFailure) only if it can't stay up: 20 crashes in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=20
OnFailure=trading-failure@%N.service

[Service]
Type=simple
WorkingDirectory=@ROOT@
# loopback only; the server refuses any other address
ExecStart=@ROOT@/.venv/bin/python dashboard/server.py --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
TimeoutStopSec=10
StandardOutput=append:@ROOT@/logs/dashboard.log
StandardError=append:@ROOT@/logs/dashboard.log
MemoryMax=300M
NoNewPrivileges=yes

[Install]
WantedBy=default.target
