[Unit]
Description=trading-agent weekly report (+ model retraining from Phase 4)
OnFailure=trading-failure@%N.service

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/.venv/bin/python learner/weekly_report.py
StandardOutput=append:@ROOT@/logs/weekly.log
StandardError=append:@ROOT@/logs/weekly.log
TimeoutStartSec=2h
