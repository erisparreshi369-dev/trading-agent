[Unit]
Description=trading-agent paper trader (signals, risk, paper engine)
After=trading-collector.service
# give up (and fire OnFailure) only if it can't stay up: 20 crashes in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=20
OnFailure=trading-failure@%N.service

[Service]
Type=simple
WorkingDirectory=@ROOT@/trader
ExecStart=@NODE@ dist/trader/index.js
Restart=always
RestartSec=5
TimeoutStopSec=20
StandardOutput=append:@ROOT@/logs/trader.log
StandardError=append:@ROOT@/logs/trader.log
MemoryMax=1500M

[Install]
WantedBy=default.target
