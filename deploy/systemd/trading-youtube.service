[Unit]
Description=trading-agent the brain studies YouTube: what top traders teach vs our data
OnFailure=trading-failure@%N.service

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/.venv/bin/python learner/youtube.py
StandardOutput=append:@ROOT@/logs/youtube.log
StandardError=append:@ROOT@/logs/youtube.log
TimeoutStartSec=1h
