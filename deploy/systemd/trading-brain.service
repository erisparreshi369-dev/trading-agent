[Unit]
Description=trading-agent learning brain: studies again after every trade result (never forgets)

# give up (and fire OnFailure) only if it can't stay up: 20 crashes in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=20
OnFailure=trading-failure@%N.service

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/.venv/bin/python learner/brain.py --watch
Restart=always
RestartSec=10
TimeoutStopSec=20
StandardOutput=append:@ROOT@/logs/brain.log
StandardError=append:@ROOT@/logs/brain.log
MemoryMax=500M

[Install]
WantedBy=default.target
