# Copy to .env and fill in. NEVER commit .env.

# Helius RPC (https://dashboard.helius.dev). Used for the pump.fun trade firehose
# (logsSubscribe) and holder checks.
HELIUS_API_KEY=

# Telegram (Phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live trading (Phase 5). Leave false. Only the owner flips this.
LIVE_TRADING=false
# Burner wallet private key, base58. Only read when LIVE_TRADING=true.
BURNER_PRIVATE_KEY=

# Optional overrides
DB_PATH=./data/trading.db
LOG_LEVEL=info

# Backup data providers (optional). Get a free key at drpc.org; Ankr may need a paid plan for live streams.
DRPC_API_KEY=
ANKR_API_KEY=
