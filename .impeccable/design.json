  "components": [
    {
      "name": "Title Bar",
      "kind": "nav",
      "refersTo": "titlebar",
      "description": "Sticky grape bar: lime PAPER badge, pixel wordmark, live dot, pill tabs.",
      "html": "<header class=\"ds-titlebar\"><span class=\"ds-mode\">PAPER</span><span class=\"ds-appname\">trading-agent</span><span class=\"ds-conn\">live</span><nav class=\"ds-tabs\"><button class=\"ds-tab\" aria-selected=\"true\">home</button><button class=\"ds-tab\">buddies</button><button class=\"ds-tab\">the brain</button><button class=\"ds-tab\">nerd stuff</button></nav></header>",
      "css": ".ds-titlebar{display:flex;align-items:center;gap:14px;height:48px;padding:0 16px;background:var(--grape,#5B3DF0);color:#fff;font:13px/1.45 Rubik,system-ui,sans-serif;box-shadow:0 1px 0 rgba(0,0,0,.12)} .ds-mode{font:700 13px/1 'Pixelify Sans',Rubik,monospace;letter-spacing:.06em;padding:5px 9px 4px;border-radius:7px;background:var(--lime,#B8F53A);color:#15163A} .ds-appname{font:700 17px/1 'Pixelify Sans',Rubik,monospace} .ds-conn{font-size:12px;color:rgba(255,255,255,.82)} .ds-conn::before{content:'';display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:var(--lime,#B8F53A)} .ds-tabs{display:flex;gap:2px;margin-left:10px} .ds-tab{border:0;cursor:pointer;padding:6px 13px;border-radius:999px;background:transparent;color:rgba(255,255,255,.86);font:600 13px Rubik,system-ui,sans-serif;transition:background .15s,color .15s} .ds-tab:hover{background:rgba(255,255,255,.14);color:#fff} .ds-tab[aria-selected=true]{background:#fff;color:#4A2FD6} .ds-tab:focus-visible{outline:2px solid var(--lime,#B8F53A);outline-offset:2px}"
    },
    {
      "name": "Away Message",
      "kind": "custom",
      "refersTo": "away-message",
      "description": "The bot's status in one sentence with a pixel face and a state pill; sun when away.",
      "html": "<section class=\"ds-away\"><svg class=\"ds-face\" viewBox=\"0 0 12 12\" shape-rendering=\"crispEdges\" aria-hidden=\"true\"><rect x=\"0\" y=\"1\" width=\"12\" height=\"10\" fill=\"#5B3DF0\"/><rect x=\"1\" y=\"0\" width=\"10\" height=\"12\" fill=\"#5B3DF0\"/><rect x=\"3\" y=\"5\" width=\"2\" height=\"1\" fill=\"#B8F53A\"/><rect x=\"7\" y=\"5\" width=\"2\" height=\"1\" fill=\"#B8F53A\"/><rect x=\"5\" y=\"8\" width=\"2\" height=\"1\" fill=\"#fff\"/></svg><div class=\"ds-away-text\"><p><b>away message:</b> brb, today's free data is used up</p><small>all parts vibing · nothing needs you</small></div><span class=\"ds-away-pill\">away till 02:00</span></section>",
      "css": ".ds-away{display:flex;align-items:center;gap:12px;padding:8px 14px;border-radius:14px;background:var(--sun-soft,#FFF6D6);border:1px solid var(--sun-line,#EED98C);color:var(--ink,#15163A);font:13px/1.45 Rubik,system-ui,sans-serif} .ds-face{width:34px;height:34px;flex:none} .ds-away-text{flex:1;min-width:0} .ds-away-text p{margin:0;font-size:15px} .ds-away-text small{display:block;font-size:12px;color:var(--ink-2,#474C7C)} .ds-away-pill{margin-left:auto;font-weight:700;font-size:12px;padding:4px 11px;border-radius:999px;background:var(--sun,#F5B20F);color:#2B1E00}"
    },
    {
      "name": "Frosted Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "The one surface: sheen, translucent fill, 14px blur, candy bevel, grape header band.",
      "html": "<article class=\"ds-panel\"><header class=\"ds-ph\"><h2>Is it OK?</h2><small>yep, all vibing</small></header><p class=\"ds-body\">Contents stay flat inside the frost.</p></article>",
      "css": ".ds-panel{background:linear-gradient(180deg,rgba(255,255,255,.55),rgba(255,255,255,0) 38%),var(--panel,rgba(255,255,255,.58));border:1px solid var(--line,#CBD3F7);border-top-color:rgba(255,255,255,.95);border-radius:16px;box-shadow:inset 0 1px 0 #fff,inset 0 -3px 0 rgba(28,32,110,.07),0 1px 2px rgba(28,32,110,.10),0 14px 30px rgba(28,32,110,.12);padding:12px 14px;backdrop-filter:blur(14px) saturate(1.3);-webkit-backdrop-filter:blur(14px) saturate(1.3);color:var(--ink,#15163A);font:13px/1.45 Rubik,system-ui,sans-serif} .ds-ph{display:flex;align-items:baseline;gap:8px;margin:-12px -14px 10px;padding:9px 14px 8px;background:rgba(91,61,240,.06);border-bottom:1px solid var(--line-2,#E1E6FB);border-radius:16px 16px 0 0} .ds-ph h2{margin:0;font-size:15px;font-weight:700} .ds-ph small{font-size:12px;color:var(--muted,#62679A)} .ds-body{margin:0}"
    },
    {
      "name": "Bag Screen",
      "kind": "custom",
      "refersTo": "bag-screen",
      "description": "Aqua status screen: the pixel money figure, delta line and a step chart.",
      "html": "<div class=\"ds-screen\"><div class=\"ds-figure\"><b>0.9772</b><span>SOL</span></div><p class=\"ds-delta\"><span class=\"ds-neg\">-0.0228 SOL all time · -2.3%</span> <span class=\"ds-mood\">· lowkey mid, not cooked</span></p><svg viewBox=\"0 0 300 70\" width=\"100%\" height=\"70\"><line x1=\"0\" x2=\"300\" y1=\"14\" y2=\"14\" stroke=\"#0D5951\" stroke-opacity=\".45\" stroke-dasharray=\"3 3\"/><path d=\"M0,14H20V30H50V44H90V56H300\" fill=\"none\" stroke=\"#15163A\" stroke-width=\"2\"/><circle cx=\"296\" cy=\"56\" r=\"4\" fill=\"#D2353C\" stroke=\"#D6F8F3\" stroke-width=\"2\"/></svg></div>",
      "css": ".ds-screen{background:var(--screen,#D6F8F3);border:1px solid var(--screen-line,#9FE3D9);border-radius:12px;padding:10px 14px 4px;color:var(--ink,#15163A);font:13px/1.45 Rubik,system-ui,sans-serif} .ds-figure{display:flex;align-items:baseline;gap:8px} .ds-figure b{font:700 74px/1 'Pixelify Sans',Rubik,monospace;letter-spacing:-.01em} .ds-figure span{font-weight:700;font-size:16px;color:var(--ink-2,#474C7C)} .ds-delta{margin:4px 0 2px;font-weight:700;font-size:14px;font-variant-numeric:tabular-nums} .ds-neg{color:var(--l,#D2353C)} .ds-mood{font-weight:500;color:var(--ink-2,#474C7C)}"
    },
    {
      "name": "Buddy Row",
      "kind": "custom",
      "refersTo": "buddy",
      "description": "A trader as a buddy: pixel identicon sized by grade, mono address, presence dot.",
      "html": "<div class=\"ds-buddy\"><svg class=\"ds-av\" width=\"40\" height=\"40\" viewBox=\"0 0 7 7\" shape-rendering=\"crispEdges\" aria-hidden=\"true\"><g fill=\"#2F6BFF\"><rect x=\"1\" y=\"1\" width=\"5\" height=\"1\"/><rect x=\"1\" y=\"2\" width=\"1\" height=\"3\"/><rect x=\"5\" y=\"2\" width=\"1\" height=\"3\"/><rect x=\"3\" y=\"2\" width=\"1\" height=\"2\"/><rect x=\"2\" y=\"5\" width=\"3\" height=\"1\"/></g></svg><span class=\"ds-who\"><b>4nDJ…tZ4s</b><small>online · 18s ago</small></span><span class=\"ds-ret\">+19.0%<small>copy return</small></span></div>",
      "css": ".ds-buddy{display:flex;align-items:center;gap:10px;font:13px/1.45 Rubik,system-ui,sans-serif;color:var(--ink,#15163A)} .ds-av{flex:none;border-radius:22%;background:var(--panel-solid,#F8F9FF);box-shadow:0 0 0 1px var(--line,#CBD3F7)} .ds-who{display:grid;line-height:1.25;flex:1;min-width:0} .ds-who b{font:600 12.5px ui-monospace,'JetBrains Mono',monospace} .ds-who small{font-size:11.5px;color:var(--muted,#62679A)} .ds-who small::before{content:'';display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px;background:var(--online,#18A866)} .ds-ret{text-align:right;font-weight:700;color:var(--w,#0A8A5E);font-variant-numeric:tabular-nums;line-height:1.2} .ds-ret small{display:block;font-weight:500;font-size:11px;color:var(--muted,#62679A)}"
    },
    {
      "name": "Chat Log Line",
      "kind": "custom",
      "refersTo": "feed",
      "description": "Live tea: tabular time, coloured lowercase speaker tag with a colon, truncating text, hanging reasons.",
      "html": "<ol class=\"ds-feed\"><li class=\"ds-ev\"><div class=\"ds-ev-head\"><span class=\"ds-tag ds-tag-bad\">skipped</span><span class=\"ds-ev-text\">skipped 4nDJ…tZ4s on $KIMCHI</span><span class=\"ds-ev-time\">02:14:19</span></div><ul><li>the creator made 10 coins in a day, that's giving scam</li></ul></li><li class=\"ds-ev\"><div class=\"ds-ev-head\"><span class=\"ds-tag ds-tag-buy\">trader buy</span><span class=\"ds-ev-text\">EUku…ziAo bought 0.4 SOL</span><span class=\"ds-ev-time\">02:12:40</span></div></li></ol>",
      "css": ".ds-feed{list-style:none;margin:0;padding:0;font:13px/1.45 Rubik,system-ui,sans-serif;color:var(--ink,#15163A)} .ds-ev{padding:5px 2px;border-bottom:1px solid var(--line-2,#E1E6FB)} .ds-ev-head{display:grid;grid-template-columns:54px auto minmax(0,1fr);align-items:baseline;gap:6px;font-size:12.5px} .ds-ev-time{order:-1;color:var(--muted,#62679A);font-size:11.5px;font-variant-numeric:tabular-nums} .ds-tag{font-weight:700;font-size:11.5px;white-space:nowrap;text-transform:lowercase} .ds-tag::after{content:':'} .ds-tag-bad{color:var(--l,#D2353C)} .ds-tag-buy{color:var(--pink,#E0408E)} .ds-ev-text{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .ds-ev ul{margin:2px 0 0 60px;padding-left:14px;color:var(--ink-2,#474C7C);font-size:12px}"
    },
    {
      "name": "Filter Chips",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Chat-log filters: grape-mist pills with a faded count; pressed is solid deep grape.",
      "html": "<div class=\"ds-filters\" role=\"toolbar\"><button class=\"ds-chip\" aria-pressed=\"true\">the tea<span>185</span></button><button class=\"ds-chip\" aria-pressed=\"false\">all<span>685</span></button><button class=\"ds-chip\" aria-pressed=\"false\">oopsies<span>62</span></button></div>",
      "css": ".ds-filters{display:flex;gap:4px;flex-wrap:wrap} .ds-chip{cursor:pointer;font:500 12px Rubik,system-ui,sans-serif;color:var(--ink-2,#474C7C);background:var(--grape-soft,#ECE8FF);border:1px solid transparent;border-radius:999px;padding:2px 9px} .ds-chip span{margin-left:5px;opacity:.75;font-variant-numeric:tabular-nums} .ds-chip:hover{border-color:var(--line,#CBD3F7)} .ds-chip[aria-pressed=true]{background:var(--grape-2,#4A2FD6);color:#fff;font-weight:600} .ds-chip:focus-visible{outline:2px solid var(--grape-2,#4A2FD6);outline-offset:2px}"
    },
    {
      "name": "Status Pills and Memory Tags",
      "kind": "chip",
      "refersTo": "pill",
      "description": "Dot-led state pills (neutral, ok, warn, bad) and the brain's smaller memory tags.",
      "html": "<div class=\"ds-row\"><span class=\"ds-pill\">just studying for now</span><span class=\"ds-pill ds-ok\">auto-skip ON</span><span class=\"ds-pill ds-warn\">lowkey sus</span><span class=\"ds-pill ds-bad\">down bad</span><span class=\"ds-mem\">new</span><span class=\"ds-mem ds-mem-ok\">locked in · 4 nights</span></div>",
      "css": ".ds-row{display:flex;gap:6px;flex-wrap:wrap;align-items:center;font-family:Rubik,system-ui,sans-serif} .ds-pill{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;padding:3px 10px;border-radius:999px;background:var(--grape-soft,#ECE8FF);color:var(--ink-2,#474C7C)} .ds-pill::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--away,#A5ABCF)} .ds-ok{background:var(--w-soft,#DDF6EA);color:var(--w,#0A8A5E)} .ds-ok::before{background:var(--online,#18A866)} .ds-warn{background:var(--sun-soft,#FFF6D6);color:var(--sun-ink,#7A5600)} .ds-warn::before{background:var(--idle,#E89B00)} .ds-bad{background:var(--l-soft,#FCE0E1);color:var(--l,#D2353C)} .ds-bad::before{background:var(--l,#D2353C)} .ds-mem{font-size:10.5px;font-weight:700;letter-spacing:.03em;padding:1px 7px;border-radius:999px;background:var(--grape-soft,#ECE8FF);color:var(--grape-2,#4A2FD6)} .ds-mem-ok{background:var(--w-soft,#DDF6EA);color:var(--w,#0A8A5E)}"
    },
    {
      "name": "Daily Limit Control",
      "kind": "input",
      "refersTo": "input-limit",
      "description": "The only input: a number field with save (deep grape) and back-to-normal buttons.",
      "html": "<div class=\"ds-ctl\"><h3>daily data limit</h3><input type=\"number\" value=\"1500\"><span class=\"ds-unit\">MB</span><button class=\"ds-save\">save</button><button class=\"ds-sec\">back to normal</button></div>",
      "css": ".ds-ctl{display:flex;gap:6px;align-items:center;flex-wrap:wrap;font:13px/1.45 Rubik,system-ui,sans-serif;color:var(--ink,#15163A)} .ds-ctl h3{margin:0 4px 0 0;font-size:13px;font-weight:700} .ds-ctl input{width:92px;font:600 13px Rubik,system-ui,sans-serif;padding:5px 8px;border:1px solid var(--line,#CBD3F7);border-radius:9px;background:var(--panel-solid,#F8F9FF);color:var(--ink,#15163A);appearance:textfield;-moz-appearance:textfield} .ds-ctl input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0} .ds-ctl input:focus{outline:2px solid var(--grape-2,#4A2FD6);outline-offset:1px} .ds-unit{color:var(--muted,#62679A)} .ds-ctl button{cursor:pointer;font:600 12.5px Rubik,system-ui,sans-serif;padding:5px 12px;border-radius:9px;border:1px solid var(--line,#CBD3F7);background:var(--panel-solid,#F8F9FF);color:var(--ink,#15163A)} .ds-ctl .ds-save{background:var(--grape-2,#4A2FD6);border-color:var(--grape-2,#4A2FD6);color:#fff} .ds-ctl .ds-save:hover{background:var(--grape,#5B3DF0)} .ds-ctl button:focus-visible{outline:2px solid var(--grape-2,#4A2FD6);outline-offset:2px} .ds-ctl button:disabled{opacity:.45;cursor:default}"
    },
    {
      "name": "Parts List",
      "kind": "custom",
      "refersTo": "parts",
      "description": "Is it OK: LED, part name, coloured state word, time, truncating detail line.",
      "html": "<ul class=\"ds-parts\"><li class=\"ds-part\"><i class=\"ds-led\"></i><b>trader</b><span class=\"ds-state\">vibing</span><em>pinged 11s ago</em><span class=\"ds-detail\">chances 4 · copied 0 · oopsies 0 this run</span></li><li class=\"ds-part ds-sched\"><i class=\"ds-led\"></i><b>the brain</b><span class=\"ds-state\">on schedule</span><em>score in 74s</em><span class=\"ds-detail\">weekly 20.3h ago · brain 47m ago</span></li></ul>",
      "css": ".ds-parts{list-style:none;margin:0;padding:0;font:13px/1.45 Rubik,system-ui,sans-serif;color:var(--ink,#15163A)} .ds-part{display:grid;grid-template-columns:14px auto 1fr auto;align-items:center;gap:0 8px;padding:6px 0;border-bottom:1px solid var(--line-2,#E1E6FB)} .ds-part b{font-weight:600} .ds-led{width:9px;height:9px;border-radius:50%;background:var(--online,#18A866)} .ds-state{font-size:12px;font-weight:600;color:var(--w,#0A8A5E)} .ds-sched .ds-led{background:var(--grape-2,#4A2FD6)} .ds-sched .ds-state{color:var(--grape-2,#4A2FD6)} .ds-part em{font-style:normal;color:var(--muted,#62679A);font-size:12px;text-align:right} .ds-detail{grid-column:2/5;color:var(--muted,#62679A);font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
    }
  ],
  "narrative": {
    "northStar": "The Bot Is Online",
    "overview": "The dashboard is the bot's messenger window, circa 2003. The bot is a buddy who is online, idle or away; its status is one away message across the top; the traders it copies are its buddy list, each with a pixel buddy icon; what it is doing scrolls by as a chat log; and its money sits on an aqua status screen with a big pixel figure. It is the owner's own bot, never a trading terminal: no KPI tile row, no hero equity chart, no dark terminal.\n\nThe material is frosted candy. An icy periwinkle ground carries three soft colour glows (lilac top left, sky right, blush bottom); over it float translucent white panels with a sheen, a bright top edge and a soft drop, like early-2000s glossy UI made gentle. Colour is candy but every candy has a job: grape is the app's own chrome and actions, lime is the PAPER badge and the live dot, aqua is money, sun-yellow means away or waiting, green and red only ever mean won or lost and working or broken. The night skin keeps the same candy on a deep indigo ground.\n\nDensity is high but calm: everything a minute-long check needs fits a 1366×768 window, 13px Rubik body, 12px gaps. Loudness is reserved for state: the away strip turns yellow or red only when something is off, the bag gets one messenger-style nudge when a trade closes, and the rest stays still.",
    "keyCharacteristics": [
      "Grape title bar with a lime PAPER badge, pixel wordmark, live dot and pill tabs.",
      "One full-width away message, coloured by the bot's state, with a 12×12 pixel face.",
      "Frosted translucent panels (16px corners, 14px blur, inset bevel, soft drop) with a tinted header band.",
      "An aqua bag screen holding the only display-size figure, in Pixelify Sans, above a step chart.",
      "Pixel identicon buddy icons whose size follows the trader's grade; online, idle and away dots.",
      "A chat-log feed in a sticky right rail on every tab: time, coloured lowercase speaker tag with a colon, text.",
      "Same candy accents in the night skin; only ground, panels, ink and grape depth change."
    ],
    "rules": [
      {
        "name": "The Every Candy Has A Job Rule",
        "body": "Grape is the app's chrome and its own actions, lime is mode and liveness, aqua is money, sun-yellow is away or waiting, bubblegum and blue are trader moves. A candy colour never appears as decoration outside its job.",
        "section": "colors"
      },
      {
        "name": "The Green Means Won Rule",
        "body": "Win green and loss red mean money up or down, or a part working or broken. They are never used for branding, buttons or emphasis.",
        "section": "colors"
      },
      {
        "name": "The Same Candy At Night Rule",
        "body": "The night skin changes ground, panels, lines, ink and grape depth only; the candy accents stay recognisably the same.",
        "section": "colors"
      },
      {
        "name": "The Pixel Is For Figures Rule",
        "body": "Pixelify Sans appears on the bag figure, the wordmark and the mode badge only. It never sets a heading, a label or a sentence.",
        "section": "typography"
      },
      {
        "name": "The Tabular Money Rule",
        "body": "Every number that can change (amounts, percentages, times, counts) uses tabular figures and right-aligns in tables.",
        "section": "typography"
      },
      {
        "name": "The One Layer Of Frost Rule",
        "body": "Panels are the only frosted, shadowed layer. Nothing inside a panel gets its own drop shadow or blur.",
        "section": "elevation"
      },
      {
        "name": "The Header Band Rule",
        "body": "A panel's header sits on a faint grape band (6% grape; 4% white at night) with a soft-line bottom edge, flush to the panel's top corners.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put the bot's state in the away message first: one sentence, a pixel face and a state pill, coloured sun when away, frost when online, loss-soft when it needs the owner.",
      "Do keep money on the aqua screen with the pixel figure as the only display-size type on the page.",
      "Do build every new surface as a frosted panel (16px corners, sheen, 14px blur, candy bevel) with a grape header band, and keep its contents flat.",
      "Do give every trader a pixel identicon and a presence dot (online under 1 hour, idle under 24 hours, away beyond).",
      "Do use Rubik with tabular figures for every number except the bag figure.",
      "Do define colours as tokens and give each new token a night value; keep the candy accents unchanged at night.",
      "Do keep motion to state changes (figure flip, one nudge per closed trade, new-line fade) and switch it off under reduced motion."
    ],
    "donts": [
      "Don't add a KPI tile row, a hero equity chart or a dark trading-terminal look; stats are a divided list under the bag screen.",
      "Don't use neon hype, flashing candles or casino effects (PRODUCT.md).",
      "Don't set headings, labels or sentences in Pixelify Sans.",
      "Don't use win green or loss red for anything except money up or down and parts working or broken.",
      "Don't use aqua outside the bag screen.",
      "Don't put walls of tables up front; long tables live on the details tab or scroll inside their panel.",
      "Don't smooth or anti-alias the pixel art; faces and identicons render with crisp edges on an integer grid."
    ]
  }
